        {
          "name": "Add User to Group",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/api/users/{{userId}}/groups",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"groupId\": \"GROUP_ID\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Remove User from Group",
          "request": {
            "method": "DELETE",
            "url": "{{BASE_URL}}/api/users/{{userId}}/groups/{{groupId}}"
          }
        },
        {
          "name": "Authenticate User (Login)",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/api/users/auth",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"secret\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Request Password Reset",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/api/users/password-reset/request",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Validate Password Reset Token",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/api/users/password-reset/validate/{{token}}"
          }
        },
        {
          "name": "Confirm Password Reset",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/api/users/password-reset/confirm",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"RESET_TOKEN\",\n  \"password\": \"newSecret123\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Generate WhatsApp Link Code",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/api/users/{{userId}}/link-code"
          }
        },
        {
          "name": "Get WhatsApp Identity",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/api/users/{{userId}}/whatsapp-identity"
          }
        },
        {
          "name": "Get User's WhatsApp Groups",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/api/users/{{userId}}/whatsapp-groups",
            "description": "Returns groups from the bot's in-memory group cache."
          }
        },
        {
          "name": "Unlink WhatsApp Identity",
          "request": {
            "method": "DELETE",
            "url": "{{BASE_URL}}/api/users/{{userId}}/whatsapp-identity"
          }
        }
