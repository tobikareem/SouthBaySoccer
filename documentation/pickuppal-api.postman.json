            "method": "POST",
            "url": "{{BASE_URL}}/api/users/register/whatsapp",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"WA_PREREG_TOKEN\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john@example.com\",\n  \"termsVersion\": \"1.0\",\n  \"termsAcceptedAt\": \"2026-06-07T00:00:00.000Z\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Get User by ID",
          "request": { "method": "GET", "url": "{{BASE_URL}}/api/users/{{userId}}" }
        },
        {
          "name": "Get User by Phone",
          "request": { "method": "GET", "url": "{{BASE_URL}}/api/users/phone/{{phoneNumber}}" }
        },
        {
          "name": "Get User by Email",
          "request": { "method": "GET", "url": "{{BASE_URL}}/api/users/email/{{email}}" }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/api/users",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"phoneNumber\": \"+14155551234\",\n  \"termsVersion\": \"1.0\",\n  \"termsAcceptedAt\": \"2026-06-07T00:00:00.000Z\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "url": "{{BASE_URL}}/api/users/{{userId}}",
            "description": "Allowed fields: email, firstName, lastName, nickName, password, phoneNumber, profilePicture, termsVersion, termsAcceptedAt",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"nickName\": \"JD\",\n  \"phoneNumber\": \"+14155551234\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Delete User",
          "request": { "method": "DELETE", "url": "{{BASE_URL}}/api/users/{{userId}}" }
        },
        {
          "name": "Get User's Games",
          "request": { "method": "GET", "url": "{{BASE_URL}}/api/users/{{userId}}/games" }
        },
        {
          "name": "Get User's Leagues",
          "request": { "method": "GET", "url": "{{BASE_URL}}/api/users/{{userId}}/leagues" }
        },
        {
          "name": "Get User's Groups",
