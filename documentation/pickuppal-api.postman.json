{
  "info": {
    "name": "PickupPal API",
    "description": "REST API for the PickupPal WhatsApp bot service. Set BASE_URL in collection variables (default: http://localhost:3005).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "BASE_URL", "value": "http://localhost:3005", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Root",
          "request": { "method": "GET", "url": "{{BASE_URL}}/" }
        },
        {
          "name": "Health Check",
          "request": { "method": "GET", "url": "{{BASE_URL}}/health" }
        },
        {
          "name": "Health Check (Simple)",
          "request": { "method": "GET", "url": "{{BASE_URL}}/health-simple" }
        }
      ]
    },
    {
      "name": "Games",
      "item": [
        {
          "name": "Get All Games",
          "request": { "method": "GET", "url": "{{BASE_URL}}/api/games" }
        },
        {
          "name": "Get Active Games",
          "request": { "method": "GET", "url": "{{BASE_URL}}/api/games/active" }
        },
        {
          "name": "Get Games by Type",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/api/games/type/{{gameType}}",
            "description": "gameType: WHATSAPP_GROUP | WEB_ONLY"
          }
        },
        {
          "name": "Get Active Web Games",
          "request": { "method": "GET", "url": "{{BASE_URL}}/api/games/web/active" }
        },
        {
          "name": "Get Game by ID",
          "request": { "method": "GET", "url": "{{BASE_URL}}/api/games/{{gameId}}" }
        },
        {
          "name": "Get Game Check-ins",
          "request": { "method": "GET", "url": "{{BASE_URL}}/api/games/{{gameId}}/checkins" }
        },
        {
          "name": "Create Game",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/api/games",
            "description": "gameType: WHATSAPP_GROUP | WEB_ONLY. For WHATSAPP_GROUP, groupId is also required. sport: SOCCER | BASKETBALL | VOLLEYBALL | TENNIS | etc.",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gameType\": \"WEB_ONLY\",\n  \"date\": \"2026-06-15\",\n  \"time\": \"18:00:00\",\n  \"location\": \"Mission Dolores Park, SF\",\n  \"maxPlayers\": 14,\n  \"creatorId\": \"USER_ID\",\n  \"sport\": \"SOCCER\",\n  \"lat\": 37.7596,\n  \"lng\": -122.4269,\n  \"timezone\": \"America/Los_Angeles\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Add Player to Game",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/api/games/{{gameId}}/players",
            "description": "playerNumber is optional when playerId is provided.",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playerId\": \"USER_ID\",\n  \"playerName\": \"John Doe\",\n  \"playerNumber\": \"+14155551234\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Remove Player from Game",
          "request": {
            "method": "DELETE",
            "url": "{{BASE_URL}}/api/games/{{gameId}}/players/{{playerId}}"
          }
        },
        {
          "name": "Update Game",
          "request": {
            "method": "PUT",
            "url": "{{BASE_URL}}/api/games/{{gameId}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"location\": \"New Location\",\n  \"maxPlayers\": 16\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Terminate Game",
          "request": {
            "method": "DELETE",
            "url": "{{BASE_URL}}/api/games/{{gameId}}"
          }
        },
        {
          "name": "Bump Player to Waitlist",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/api/games/{{gameId}}/bump-player/{{playerId}}"
          }
        },
        {
          "name": "Promote Player from Waitlist",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/api/games/{{gameId}}/promote-player/{{playerId}}"
          }
        },
        {
          "name": "Remove Player from Game (action)",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/api/games/{{gameId}}/remove-player/{{playerId}}"
          }
        }
      ]
    },
    {
      "name": "Guests",
      "item": [
        {
          "name": "Add Guest to Game",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/api/games/{{gameId}}/guests",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"guestName\": \"Guest Player\",\n  \"addedById\": \"USER_ID\",\n  \"addedByName\": \"John Doe\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Promote Guest from Waitlist",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/api/games/{{gameId}}/promote-guest/{{guestId}}"
          }
        },
        {
          "name": "Remove Guest from Waitlist",
          "request": {
            "method": "DELETE",
            "url": "{{BASE_URL}}/api/games/{{gameId}}/guests/{{guestId}}"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get All Users",
          "request": { "method": "GET", "url": "{{BASE_URL}}/api/users" }
        },
        {
          "name": "Search Users",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/users/search?q=",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "users", "search"],
              "query": [{ "key": "q", "value": "" }]
            },
            "description": "Search by name or phone number."
          }
        },
        {
          "name": "Validate WhatsApp Pre-reg Token",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/users/register/whatsapp/validate?token=",
