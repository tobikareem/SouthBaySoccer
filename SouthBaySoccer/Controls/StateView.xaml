<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="SouthBaySoccer.Controls.StateView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Grid>
        <ContentPresenter x:Name="ContentPresenter"
                          Content="{Binding Body, Source={x:Reference Root}}" />
        <VerticalStackLayout x:Name="StatePanel"
                             Padding="{StaticResource SpaceXl}"
                             Spacing="{StaticResource SpaceMd}"
                             HorizontalOptions="Center"
                             VerticalOptions="Center">
            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="True"
                               Color="{AppThemeBinding Light={StaticResource BrandGreenLight}, Dark={StaticResource BrandGreenDarkTheme}}" />
            <Label Text="{Binding Glyph, Source={x:Reference Root}}"
                   Style="{StaticResource TextDisplay}"
                   HorizontalTextAlignment="Center" />
            <Label Text="{Binding Title, Source={x:Reference Root}}"
                   Style="{StaticResource TextH2}"
                   HorizontalTextAlignment="Center"
                   SemanticProperties.HeadingLevel="Level2" />
            <Label Text="{Binding Message, Source={x:Reference Root}}"
                   Style="{StaticResource TextCaption}"
                   HorizontalTextAlignment="Center" />
            <Button x:Name="RetryButton"
                    Text="Try again"
                    Command="{Binding RetryCommand, Source={x:Reference Root}}"
                    Style="{StaticResource PrimaryButton}"
                    SemanticProperties.Description="Retry" />
        </VerticalStackLayout>
    </Grid>
</ContentView>
