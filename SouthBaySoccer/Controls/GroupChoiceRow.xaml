<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="SouthBaySoccer.Controls.GroupChoiceRow"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SouthBaySoccer.Controls"
    x:Name="Root"
    x:DataType="controls:GroupChoiceRow">
    <Border Padding="{StaticResource SpaceMd}"
            MinimumHeightRequest="{StaticResource TouchMin}"
            Stroke="{AppThemeBinding Light={StaticResource BrandLineLight}, Dark={StaticResource BrandLineDark}}"
            StrokeShape="RoundRectangle 14"
            SemanticProperties.Description="{Binding SemanticDescription, Source={x:Reference Root}}">
        <Border.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding IsSelected, Source={x:Reference Root}}" Value="True">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BrandMistLight}, Dark={StaticResource BrandMistDark}}" />
                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BrandGreenLight}, Dark={StaticResource BrandGreenDarkTheme}}" />
            </DataTrigger>
        </Border.Triggers>
        <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
            <Label Text="{Binding GroupName, Source={x:Reference Root}}" Style="{StaticResource TextBodyStrong}" />
            <Label Text="{Binding MemberCountText, Source={x:Reference Root}}" Style="{StaticResource TextCaption}" />
        </VerticalStackLayout>
    </Border>
</ContentView>
