<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="SouthBaySoccer.Controls.PlayerRow"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SouthBaySoccer.Controls">
    <Grid Padding="{StaticResource RowPadding}"
          ColumnDefinitions="Auto,*,Auto"
          ColumnSpacing="{StaticResource SpaceMd}"
          MinimumHeightRequest="{StaticResource TouchMin}">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding TapCommand, Source={x:Reference Root}}"
                                  CommandParameter="{Binding TapCommandParameter, Source={x:Reference Root}}" />
        </Grid.GestureRecognizers>
        <controls:Avatar Initials="{Binding Initials, Source={x:Reference Root}}"
                         ImageSource="{Binding ImageSource, Source={x:Reference Root}}"
                         Description="{Binding Name, Source={x:Reference Root}}" />
        <VerticalStackLayout Grid.Column="1"
                             Spacing="{StaticResource SpaceXs}"
                             VerticalOptions="Center">
            <Label Text="{Binding Name, Source={x:Reference Root}}"
                   Style="{StaticResource TextBodyStrong}" />
            <Label Text="{Binding Detail, Source={x:Reference Root}}"
                   Style="{StaticResource TextCaption}" />
        </VerticalStackLayout>
        <Grid Grid.Column="2" VerticalOptions="Center">
            <Label Text="{Binding TrailingText, Source={x:Reference Root}}"
                   Style="{StaticResource TextBodyStrong}" />
            <ContentView Content="{Binding TrailingContent, Source={x:Reference Root}}" />
        </Grid>
    </Grid>
</ContentView>
