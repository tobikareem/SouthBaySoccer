<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="SouthBaySoccer.Controls.PlayerRow"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SouthBaySoccer.Controls">
    <Grid Padding="{StaticResource RowPadding}"
          ColumnDefinitions="Auto,*,Auto"
          ColumnSpacing="{StaticResource SpaceMd}"
          MinimumHeightRequest="{StaticResource TouchMin}">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding TapCommand, Source={x:Reference Root}}"
                                  CommandParameter="{Binding TapCommandParameter, Source={x:Reference Root}}" />
        </Grid.GestureRecognizers>
        <HorizontalStackLayout Spacing="{StaticResource SpaceMd}" VerticalOptions="Center">
            <ContentView x:Name="LeadingSlot"
                         IsVisible="False"
                         Content="{Binding LeadingContent, Source={x:Reference Root}}"
                         VerticalOptions="Center" />
            <controls:Avatar x:Name="AvatarSlot"
                             Initials="{Binding Initials, Source={x:Reference Root}}"
                             ImageSource="{Binding ImageSource, Source={x:Reference Root}}"
                             Description="{Binding Name, Source={x:Reference Root}}" />
            <!-- Menu/navigation rows show a real icon tile, never a fake person avatar. Setting
                 Glyph swaps this in for the Avatar; leaving it unset keeps the row about a person. -->
            <Border x:Name="GlyphSlot"
                    Style="{StaticResource IconTileSurface}"
                    IsVisible="False"
                    VerticalOptions="Center"
                    AutomationProperties.IsInAccessibleTree="False">
                <Label Text="{Binding Glyph, Source={x:Reference Root}}"
                       FontFamily="{Binding GlyphFontFamily, Source={x:Reference Root}}"
                       Style="{StaticResource BrandIconLabel}"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>
        </HorizontalStackLayout>
        <VerticalStackLayout Grid.Column="1"
                             Spacing="{StaticResource SpaceXs}"
                             VerticalOptions="Center">
            <Label Text="{Binding Name, Source={x:Reference Root}}"
                   Style="{StaticResource TextBodyStrong}"
                   LineBreakMode="TailTruncation" />
            <Label Text="{Binding Detail, Source={x:Reference Root}}"
                   Style="{StaticResource TextCaption}" />
        </VerticalStackLayout>
        <Grid Grid.Column="2" VerticalOptions="Center">
            <Label Text="{Binding TrailingText, Source={x:Reference Root}}"
                   Style="{StaticResource TextBodyStrong}" />
            <ContentView Content="{Binding TrailingContent, Source={x:Reference Root}}" />
        </Grid>
    </Grid>
</ContentView>
