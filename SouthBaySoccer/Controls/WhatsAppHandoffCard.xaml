<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="SouthBaySoccer.Controls.WhatsAppHandoffCard"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SouthBaySoccer.Controls"
             xmlns:fonts="clr-namespace:Fonts"
             x:Name="Root"
             x:DataType="controls:WhatsAppHandoffCard">
    <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
        <Label Text="{Binding Label, Source={x:Reference Root}}"
               Style="{StaticResource TextLabel}" />
        <Border Style="{StaticResource WelcomeInputSurface}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceSm}">
                <Label Text="{x:Static fonts:FontAwesomeGlyphs.PaperPlane}"
                       FontFamily="FontAwesomeSolid"
                       FontSize="{StaticResource IconMd}"
                       TextColor="{AppThemeBinding Light={StaticResource BrandSageLight}, Dark={StaticResource BrandSageDark}}"
                       VerticalTextAlignment="Center"
                       AutomationProperties.IsInAccessibleTree="False" />
                <Label Grid.Column="1"
                       Text="{Binding MessageText, Source={x:Reference Root}}"
                       Style="{StaticResource TextBodyStrong}"
                       VerticalTextAlignment="Center"
                       SemanticProperties.Description="{Binding MessageText, Source={x:Reference Root}, StringFormat='Message to send: {0}'}" />
            </Grid>
        </Border>
        <Label Text="{Binding Hint, Source={x:Reference Root}}"
               Style="{StaticResource TextCaption}" />
        <Grid>
            <Button Text="{Binding ButtonText, Source={x:Reference Root}}"
                    Command="{Binding ContinueCommand, Source={x:Reference Root}}"
                    IsEnabled="{Binding IsNotBusy, Source={x:Reference Root}}"
                    Style="{StaticResource WhatsAppButton}"
                    SemanticProperties.Description="{Binding ButtonText, Source={x:Reference Root}}" />
            <Label Text="{x:Static fonts:FontAwesomeGlyphs.WhatsApp}"
                   FontFamily="FontAwesomeBrands"
                   FontSize="{StaticResource IconMd}"
                   TextColor="{StaticResource BrandWhite}"
                   HorizontalOptions="Start"
                   Margin="{StaticResource WelcomeButtonIconMargin}"
                   VerticalTextAlignment="Center"
                   InputTransparent="True" />
            <ActivityIndicator IsRunning="{Binding IsBusy, Source={x:Reference Root}}"
                               IsVisible="{Binding IsBusy, Source={x:Reference Root}}"
                               Color="{StaticResource BrandWhite}"
                               HorizontalOptions="End"
                               Margin="{StaticResource WelcomeButtonBusyMargin}" />
        </Grid>
    </VerticalStackLayout>
</ContentView>
