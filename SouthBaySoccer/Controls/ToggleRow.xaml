<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="SouthBaySoccer.Controls.ToggleRow"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SouthBaySoccer.Controls"
             x:Name="Root"
             x:DataType="controls:ToggleRow">
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SpaceMd}">
        <Border Style="{StaticResource IconTileSurface}">
            <Label Text="{Binding Glyph, Source={x:Reference Root}}"
                   FontFamily="{Binding GlyphFontFamily, Source={x:Reference Root}}"
                   HorizontalOptions="Center" VerticalOptions="Center" />
        </Border>
        <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource SpaceXs}">
            <Label Text="{Binding Title, Source={x:Reference Root}}" Style="{StaticResource TextBodyStrong}" />
            <Label Text="{Binding Subtitle, Source={x:Reference Root}}" Style="{StaticResource TextCaption}" />
        </VerticalStackLayout>
        <Switch Grid.Column="2"
                IsToggled="{Binding IsToggled, Source={x:Reference Root}, Mode=TwoWay}"
                IsEnabled="{Binding IsEnabled, Source={x:Reference Root}}"
                SemanticProperties.Description="{Binding Title, Source={x:Reference Root}}" />
    </Grid>
</ContentView>
