<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="SouthBaySoccer.Controls.StatTile"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Border Style="{StaticResource StatTileSurface}">
        <VerticalStackLayout Spacing="{StaticResource SpaceXs}"
                             HorizontalOptions="Center">
            <Label Text="{Binding Glyph, Source={x:Reference Root}}"
                   Style="{StaticResource TextCaption}"
                   HorizontalTextAlignment="Center" />
            <Label Text="{Binding Value, Source={x:Reference Root}}"
                   Style="{StaticResource TextStat}"
                   HorizontalTextAlignment="Center" />
            <Label Text="{Binding Label, Source={x:Reference Root}}"
                   Style="{StaticResource TextCaption}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Border>
</ContentView>
