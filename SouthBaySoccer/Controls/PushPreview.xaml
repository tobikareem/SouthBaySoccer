<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="SouthBaySoccer.Controls.PushPreview"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SouthBaySoccer.Controls"
             x:Name="Root"
             x:DataType="controls:PushPreview">
    <Border Padding="{StaticResource SpaceMd}"
            BackgroundColor="{StaticResource BrandGreenDepthLight}"
            StrokeShape="RoundRectangle 16">
        <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
            <Label Text="N9JA BAY" TextColor="{StaticResource BrandWhite}" Style="{StaticResource TextCaption}" />
            <Label Text="{Binding Title, Source={x:Reference Root}}" TextColor="{StaticResource BrandWhite}" Style="{StaticResource TextBodyStrong}" />
            <Label Text="{Binding Body, Source={x:Reference Root}}"
                   TextColor="{StaticResource BrandWhite}"
                   Style="{StaticResource TextCaption}"
                   MaxLines="2"
                   LineBreakMode="TailTruncation" />
        </VerticalStackLayout>
    </Border>
</ContentView>
