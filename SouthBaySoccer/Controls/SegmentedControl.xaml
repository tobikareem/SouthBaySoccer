<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="SouthBaySoccer.Controls.SegmentedControl"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Border Style="{StaticResource TintSurface}"
            Padding="{StaticResource SpaceXs}"
            StrokeShape="{StaticResource ShapeSegment}">
        <FlexLayout x:Name="Segments"
                    Direction="Row"
                    JustifyContent="SpaceBetween" />
    </Border>
</ContentView>
