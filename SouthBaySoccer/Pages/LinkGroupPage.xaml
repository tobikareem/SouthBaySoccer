<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SouthBaySoccer.Pages.LinkGroupPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:SouthBaySoccer.Controls"
    xmlns:fonts="clr-namespace:Fonts"
    xmlns:pageModels="clr-namespace:SouthBaySoccer.PageModels"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="LinkGroupPageName"
    x:DataType="pageModels:LinkGroupPageModel"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    Style="{StaticResource BrandPage}"
    Title="Join your groups">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference LinkGroupPageName}, x:DataType=ContentPage}"
            EventName="Appearing"
            Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <c:StateView
        State="{Binding State}"
        Title="{Binding StateTitle}"
        Message="{Binding StateMessage}"
        Glyph="{x:Static fonts:FontAwesomeGlyphs.Users}"
        GlyphFontFamily="FontAwesomeSolid"
        RetryCommand="{Binding RefreshCommand}">
        <Grid>
            <!-- Step 1: pick every group you play with. -->
            <Grid
                Padding="{StaticResource LayoutPadding}"
                RowDefinitions="Auto,Auto,*,Auto,Auto"
                RowSpacing="{StaticResource SpaceMd}"
                IsVisible="{Binding IsChoosing}">

                <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                    <Label
                        Text="Step 2 of 2"
                        Style="{StaticResource TextLabel}" />
                    <Label
                        Text="Join your groups"
                        Style="{StaticResource TextH1}"
                        SemanticProperties.HeadingLevel="Level1" />
                    <Label
                        Text="Pick every WhatsApp group you play with. Groups that already list you on WhatsApp are approved instantly; the rest wait for a group admin."
                        Style="{StaticResource TextCaption}" />
                </VerticalStackLayout>

                <!-- Requests still waiting from an earlier visit. -->
                <c:BrandCard Grid.Row="1" IsVisible="{Binding HasAlreadyPending}" IsTinted="True">
                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding AlreadyPending}"
                        Spacing="{StaticResource SpaceXs}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="pageModels:GroupRequestOutcome">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SpaceSm}"
                                      MinimumHeightRequest="{StaticResource TouchMin}"
                                      SemanticProperties.Description="{Binding SemanticDescription}">
                                    <Label Text="{x:Static fonts:FontAwesomeGlyphs.Clock}" FontFamily="FontAwesomeSolid"
                                           Style="{StaticResource BrandIconLabel}"
                                           TextColor="{AppThemeBinding Light={StaticResource WarningLight}, Dark={StaticResource WarningDark}}"
                                           VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False" />
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" Style="{StaticResource TextBodyStrong}" />
                                        <Label Text="{Binding Detail}" Style="{StaticResource TextCaption}" />
                                    </VerticalStackLayout>
                                    <c:Badge Grid.Column="2" Text="{Binding Status}" Variant="{Binding StatusVariant}" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </c:BrandCard>

                <CollectionView
                    Grid.Row="2"
                    ItemsSource="{Binding Groups}"
                    SelectionMode="Multiple"
                    SelectedItems="{Binding SelectedGroups}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="{StaticResource SpaceSm}" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="pageModels:GroupChoiceItem">
                            <Border
                                Style="{StaticResource CardSurface}"
                                MinimumHeightRequest="{StaticResource TouchMin}"
                                SemanticProperties.Description="{Binding SemanticDescription}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter
                                                    Property="BackgroundColor"
                                                    Value="{AppThemeBinding Light={StaticResource BrandMistLight}, Dark={StaticResource BrandMistDark}}" />
                                                <Setter
                                                    Property="Stroke"
                                                    Value="{AppThemeBinding Light={StaticResource BrandGreenLight}, Dark={StaticResource BrandGreenDarkTheme}}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceMd}">
                                    <!-- Mirrors the CollectionView selection; the row itself is the tap target. -->
                                    <CheckBox
                                        IsChecked="{Binding IsSelected}"
                                        InputTransparent="True"
                                        VerticalOptions="Center"
                                        AutomationProperties.IsInAccessibleTree="False" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label
                                            Text="{Binding Name}"
                                            Style="{StaticResource TextBodyStrong}" />
                                        <Label
                                            Text="{Binding MemberCountText}"
                                            Style="{StaticResource TextCaption}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label
                    Grid.Row="3"
                    Text="{Binding SelectedCountText}"
                    Style="{StaticResource TextCaption}"
                    HorizontalTextAlignment="Center" />

                <Button
                    Grid.Row="4"
                    Text="Continue"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding ContinueCommand}"
                    SemanticProperties.Description="Request to join the selected groups" />
            </Grid>

            <!-- Step 2: what the server decided for each group. -->
            <Grid RowDefinitions="Auto,*" IsVisible="{Binding HasResult}">
                <c:BrandHeader
                    Title="{Binding ResultTitle}"
                    Subtitle="{Binding ResultSubtitle}">
                    <c:BrandHeader.LeadingContent>
                        <Border Style="{StaticResource IconTileSurface}" VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False">
                            <Label Text="{x:Static fonts:FontAwesomeGlyphs.Users}" FontFamily="FontAwesomeSolid"
                                   Style="{StaticResource BrandIconLabel}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </c:BrandHeader.LeadingContent>
                </c:BrandHeader>
                <ScrollView Grid.Row="1">
                    <VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="{StaticResource SpaceLg}">
                        <c:BrandCard>
                            <VerticalStackLayout
                                BindableLayout.ItemsSource="{Binding Outcomes}"
                                Spacing="{StaticResource SpaceXs}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="pageModels:GroupRequestOutcome">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SpaceSm}"
                                              MinimumHeightRequest="{StaticResource TouchMin}"
                                              SemanticProperties.Description="{Binding SemanticDescription}">
                                            <Label Text="{x:Static fonts:FontAwesomeGlyphs.CircleCheck}" FontFamily="FontAwesomeSolid"
                                                   Style="{StaticResource BrandIconLabel}" VerticalOptions="Center"
                                                   IsVisible="{Binding IsApproved}" AutomationProperties.IsInAccessibleTree="False" />
                                            <Label Text="{x:Static fonts:FontAwesomeGlyphs.Clock}" FontFamily="FontAwesomeSolid"
                                                   Style="{StaticResource BrandIconLabel}"
                                                   TextColor="{AppThemeBinding Light={StaticResource WarningLight}, Dark={StaticResource WarningDark}}"
                                                   VerticalOptions="Center"
                                                   IsVisible="{Binding IsPending}"
                                                   AutomationProperties.IsInAccessibleTree="False" />
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                <Label Text="{Binding Name}" Style="{StaticResource TextBodyStrong}" />
                                                <Label Text="{Binding Detail}" Style="{StaticResource TextCaption}" />
                                            </VerticalStackLayout>
                                            <c:Badge Grid.Column="2" Text="{Binding Status}" Variant="{Binding StatusVariant}" VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </c:BrandCard>

                        <Button
                            Text="See upcoming sessions"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ContinueToAppCommand}"
                            SemanticProperties.Description="Continue to upcoming sessions" />
                        <Label
                            Text="You can join more groups or leave one any time from Profile → My groups."
                            Style="{StaticResource TextCaption}"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Grid>
    </c:StateView>
</ContentPage>
