<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SouthBaySoccer.Pages.GameDayPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:SouthBaySoccer.Controls"
    xmlns:gameDay="clr-namespace:SouthBaySoccer.Contracts.GameDay;assembly=SouthBaySoccer.Contracts"
    xmlns:fonts="clr-namespace:Fonts"
    xmlns:pageModels="clr-namespace:SouthBaySoccer.PageModels"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="GameDay"
    x:DataType="pageModels:GameDayPageModel"
    Shell.NavBarIsVisible="False"
    Style="{StaticResource BrandPage}"
    Title="Game Day">
    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference GameDay}, x:DataType=ContentPage}"
            EventName="Appearing"
            Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>
    <c:StateView State="{Binding State}" Title="{Binding StateTitle}" Message="{Binding StateMessage}" Glyph="{x:Static fonts:FontAwesomeGlyphs.Futbol}" GlyphFontFamily="FontAwesomeSolid" RetryCommand="{Binding RetryCommand}">
        <RefreshView Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}">
        <ScrollView>
            <VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="{StaticResource SpaceMd}">
                <!-- Shared header: which group and field this page is about, the session's own title,
                     and a status badge whose colour follows the state instead of always reading green. -->
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                        <Label Style="{StaticResource TextCaption}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding DisplayDateLabel}" />
                                    <Span Text=" - " />
                                    <Span Text="{Binding DisplayHeaderContextLabel}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label Text="{Binding DisplayTitle}" Style="{StaticResource TextH1}" SemanticProperties.HeadingLevel="Level1" />
                    </VerticalStackLayout>
                    <!-- Variant computed on the page model (StatusBadgeVariant): competing DataTriggers
                         on one property resolve by activation order, not declaration order. -->
                    <c:Badge Grid.Column="1" Text="{Binding StatusLabel}" Glyph="{x:Static fonts:FontAwesomeGlyphs.Clock}" Variant="{Binding StatusBadgeVariant}" IsVisible="{Binding ShowStatusBadge}" />
                </Grid>

                <!-- Player view switch: today's activity remains the default while recent attended
                     games stay available from the same tab. Admins retain their separate scope. -->
                <VerticalStackLayout Spacing="{StaticResource SpaceXs}" IsVisible="{Binding ShowPlayerViewSwitch}">
                    <c:SegmentedControl
                        ItemsSource="{Binding PlayerViewOptions}"
                        SelectedIndex="{Binding SelectedPlayerViewIndex}"
                        SelectionChangedCommand="{Binding SelectPlayerViewCommand}" />
                    <Label Text="Review your last three games without leaving today's Game Day." Style="{StaticResource TextCaption}" Opacity="0.7" />
                </VerticalStackLayout>

                <!-- Game-admin scope switch: my games vs everything running today. -->
                <VerticalStackLayout Spacing="{StaticResource SpaceXs}" IsVisible="{Binding CanShowAllGames}">
                    <c:SegmentedControl
                        ItemsSource="{Binding GameScopeOptions}"
                        SelectedIndex="{Binding SelectedGameScopeIndex}"
                        SelectionChangedCommand="{Binding SelectGameScopeCommand}" />
                    <Label Text="Admins can switch to every game running today to run check-in or matching." Style="{StaticResource TextCaption}" Opacity="0.7" />
                </VerticalStackLayout>

                <!-- More than one relevant game today: a full vertical list (no hidden horizontal
                     scroll) so it is obvious the player can switch which game Game Day shows. -->
                <VerticalStackLayout Spacing="{StaticResource SpaceSm}" IsVisible="{Binding ShowMultipleGames}">
                    <c:SectionHeader Text="Today's games" />
                    <Label Text="You have more than one game today - tap a game to switch." Style="{StaticResource TextCaption}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding TodaysGames}" Spacing="{StaticResource SpaceSm}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="pageModels:GameDayGameOption">
                                <Border Style="{StaticResource CardSurface}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding BindingContext.SelectGameCommand, Source={x:Reference GameDay}}" CommandParameter="{Binding SessionId}" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BrandGreenLight}, Dark={StaticResource BrandGreenDarkTheme}}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                                        <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                                            <Label Text="{Binding Title}" Style="{StaticResource TextBodyStrong}" />
                                            <Label Style="{StaticResource TextCaption}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding TimeLabel}" />
                                                        <Span Text=" - " />
                                                        <Span Text="{Binding Venue}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label Text="{Binding StatusLabel}" Style="{StaticResource TextCaption}" Opacity="0.7" />
                                        </VerticalStackLayout>
                                        <Label
                                            Grid.Column="1"
                                            VerticalOptions="Center"
                                            Text="{x:Static fonts:FontAwesomeGlyphs.CircleCheck}"
                                            FontFamily="FontAwesomeSolid"
                                            Style="{StaticResource BrandIconLabel}"
                                            IsVisible="{Binding IsSelected}"
                                            SemanticProperties.Description="Currently selected game" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Spectator: watching a group's game without holding a spot on it. One banner says
                     exactly what this view is; one card offers the only available action, Join. -->
                <VerticalStackLayout Spacing="{StaticResource SpaceMd}" IsVisible="{Binding ShowSpectatorContent}">
                    <Border Style="{StaticResource NoticeSurface}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceSm}">
                            <Label Text="{x:Static fonts:FontAwesomeGlyphs.CircleInfo}" FontFamily="FontAwesomeSolid" Style="{StaticResource BrandIconLabel}" />
                            <Label Grid.Column="1" Text="{Binding SpectatorBannerText}" Style="{StaticResource TextCaption}" />
                        </Grid>
                    </Border>
                    <c:BrandCard IsTinted="True">
                        <VerticalStackLayout Spacing="{StaticResource SpaceSm}">
                            <Label Text="Want to play?" Style="{StaticResource TextBodyStrong}" />
                            <Label Style="{StaticResource TextCaption}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Kick-off " />
                                        <Span Text="{Binding GameStartLabel}" />
                                        <Span Text=" at " />
                                        <Span Text="{Binding Venue}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <c:CapacityBar Current="{Binding GoingCount}" Max="{Binding Capacity}" />
                            <Button
                                Text="Join this game"
                                Command="{Binding JoinCommand}"
                                Style="{StaticResource PrimaryButton}"
                                IsVisible="{Binding CanJoin}"
                                SemanticProperties.Description="Join this game - the full game puts you on the waitlist" />
                            <Label Text="If the game is full you'll be added to the waitlist." Style="{StaticResource TextCaption}" Opacity="0.7" IsVisible="{Binding CanJoin}" />
                            <Label Text="{Binding JoinBlockedReason}" Style="{StaticResource TextCaption}" IsVisible="{Binding HasJoinBlockedReason}" />
                        </VerticalStackLayout>
                    </c:BrandCard>
                </VerticalStackLayout>

                <!-- Participant: the full game-day machinery. -->
                <VerticalStackLayout Spacing="{StaticResource SpaceMd}" IsVisible="{Binding IsParticipant}">
                    <c:BrandCard IsHero="True">
                        <VerticalStackLayout Spacing="{StaticResource SpaceMd}">
                            <Label Text="Check-in window" Style="{StaticResource TextLabel}" TextColor="White" />
                            <Label Text="{Binding CheckInWindowLabel}" Style="{StaticResource TextDisplay}" TextColor="White" />
                            <HorizontalStackLayout Spacing="{StaticResource SpaceSm}">
                                <Border Style="{StaticResource MetadataChip}" BackgroundColor="{StaticResource HeaderOverlay}">
                                    <Label Text="{Binding GameStartLabel, StringFormat='Game starts {0}'}" Style="{StaticResource TextCaption}" TextColor="White" />
                                </Border>
                                <Border Style="{StaticResource MetadataChip}" BackgroundColor="{StaticResource HeaderOverlay}">
                                    <Label Text="{Binding CheckInCloseLabel}" Style="{StaticResource TextCaption}" TextColor="White" />
                                </Border>
                            </HorizontalStackLayout>
                            <Button Text="{Binding PrimaryActionText}" Command="{Binding CheckInCommand}" Style="{StaticResource HeroInverseButton}" SemanticProperties.Description="{Binding PrimaryActionText}" />
                        </VerticalStackLayout>
                    </c:BrandCard>
                    <Label Text="{Binding BlockReason}" Style="{StaticResource TextCaption}" IsVisible="{Binding HasBlockReason}" />
                </VerticalStackLayout>

                <!-- Counts are shared by participants and spectators; tap a count to see the people. -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource SpaceSm}" IsVisible="{Binding ShowTodayContent}">
                    <c:StatTile Value="{Binding GoingCount}" Label="Going" SemanticProperties.Hint="Tap to see who is going">
                        <c:StatTile.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShowRosterCommand}" CommandParameter="Going" />
                        </c:StatTile.GestureRecognizers>
                    </c:StatTile>
                    <c:StatTile Grid.Column="1" Value="{Binding WaitlistCount}" Label="Waitlist" SemanticProperties.Hint="Tap to see the waitlist">
                        <c:StatTile.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShowRosterCommand}" CommandParameter="Waitlist" />
                        </c:StatTile.GestureRecognizers>
                    </c:StatTile>
                    <c:StatTile Grid.Column="2" Value="{Binding CheckedInCount}" Label="Checked in" SemanticProperties.Hint="Tap to see who is checked in">
                        <c:StatTile.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShowRosterCommand}" CommandParameter="CheckedIn" />
                        </c:StatTile.GestureRecognizers>
                    </c:StatTile>
                </Grid>
                <Label Text="Tap a count above to see who's going, the waitlist, or who's checked in." Style="{StaticResource TextCaption}" HorizontalTextAlignment="Center" Opacity="0.7" IsVisible="{Binding ShowTodayContent}" />

                <!-- Participant-only guidance and actions. -->
                <VerticalStackLayout Spacing="{StaticResource SpaceMd}" IsVisible="{Binding IsParticipant}">
                    <Border Style="{StaticResource NoticeSurface}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceSm}">
                            <Label Text="{x:Static fonts:FontAwesomeGlyphs.CircleInfo}" FontFamily="FontAwesomeSolid" Style="{StaticResource BrandIconLabel}" />
                            <Label Grid.Column="1" Text="{x:Static pageModels:GameDayPageModel.NoticeText}" Style="{StaticResource TextCaption}" />
                        </Grid>
                    </Border>
                    <VerticalStackLayout Spacing="{StaticResource SpaceSm}" IsVisible="{Binding CanLateCheckIn}">
                        <c:SectionHeader Text="Late check-in override" />
                        <Label Text="After the regular window closes, enter a reason before checking in an arrived player." Style="{StaticResource TextCaption}" />
                        <Label Text="Reason for late arrival" Style="{StaticResource TextLabel}" />
                        <Entry
                            Text="{Binding LateCheckInReason}"
                            Style="{StaticResource BrandEntry}"
                            Placeholder="For example, traffic delay"
                            MaxLength="240"
                            SemanticProperties.Description="Reason required for the audited late check-in override" />
                        <VerticalStackLayout
                            BindableLayout.ItemsSource="{Binding LateCheckInPlayers}"
                            Spacing="{StaticResource SpaceSm}"
                            IsVisible="{Binding HasLateCheckInPlayers}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="gameDay:GameDayPlayerDto">
                                    <Border Style="{StaticResource CardSurface}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                                            <VerticalStackLayout VerticalOptions="Center" Spacing="{StaticResource SpaceXs}">
                                                <Label Text="{Binding DisplayName}" Style="{StaticResource TextBodyStrong}" />
                                                <Label Text="Confirmed member and not checked in" Style="{StaticResource TextCaption}">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsGuest}" Value="True">
                                                            <Setter Property="Text" Value="Confirmed guest and not checked in" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </VerticalStackLayout>
                                            <Button
                                                Grid.Column="1"
                                                Text="Check in late"
                                                Command="{Binding Source={x:Reference GameDay}, Path=BindingContext.LateCheckInCommand}"
                                                CommandParameter="{Binding .}"
                                                Style="{StaticResource SecondaryButton}"
                                                SemanticProperties.Description="{Binding DisplayName, StringFormat='Check in {0} late'}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label Text="Everyone confirmed for today is already checked in." Style="{StaticResource TextCaption}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding HasLateCheckInPlayers}" Value="True">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>
                    <c:SectionHeader Text="Game-day actions" IsVisible="{Binding HasGameDayActions}" />
                    <c:PlayerRow Glyph="{x:Static fonts:FontAwesomeGlyphs.Users}" Name="Assign captains" Detail="2, 3, or 4 captains = 2, 3, or 4 teams" TapCommand="{Binding OpenCaptainAssignmentCommand}" IsVisible="{Binding CanAssignCaptains}" />
                    <c:PlayerRow Glyph="{x:Static fonts:FontAwesomeGlyphs.ShieldHalved}" Name="Pick your team" Detail="Captain permission - session scoped" TapCommand="{Binding OpenTeamDraftCommand}" IsVisible="{Binding ShowPickTeam}" />
                    <c:PlayerRow Glyph="{x:Static fonts:FontAwesomeGlyphs.Users}" Name="View your team" Detail="See your team and who you're up against" TapCommand="{Binding OpenTeamsViewCommand}" IsVisible="{Binding ShowViewTeams}" />
                    <c:PlayerRow Glyph="{x:Static fonts:FontAwesomeGlyphs.CalendarDays}" Name="Recent games" Detail="Fix teams or review stats after the game" TapCommand="{Binding OpenRecentGamesCommand}" IsVisible="{Binding CanManageCheckIns}" />
                    <c:PlayerRow Glyph="{x:Static fonts:FontAwesomeGlyphs.CirclePlus}" Name="Not on the list?" Detail="Claim your spot on a recent game" TapCommand="{Binding OpenClaimSpotCommand}" />
                    <c:PlayerRow Glyph="{x:Static fonts:FontAwesomeGlyphs.ChartColumn}" Name="Submit your stats" Detail="Report your goals and assists for confirmation" TapCommand="{Binding OpenMatchStatsCommand}" IsVisible="{Binding CanSubmitOwnStats}" />
                    <c:PlayerRow Glyph="{x:Static fonts:FontAwesomeGlyphs.Star}" Name="Rate teammates" Detail="Rate, like, and pick one MVP" TapCommand="{Binding OpenRateTeammatesCommand}" IsVisible="{Binding CanSubmitOwnStats}" />
                    <c:PlayerRow Glyph="{x:Static fonts:FontAwesomeGlyphs.ShieldHalved}" Name="Approve stats and result" Detail="After game - captains only" TapCommand="{Binding OpenPostGameApprovalCommand}" IsVisible="{Binding CanApprovePostGame}" />
                </VerticalStackLayout>

                <!-- No relevant game today: say so plainly, then show where things last stood. -->
                <VerticalStackLayout Spacing="{StaticResource SpaceMd}" IsVisible="{Binding ShowRecentSummary}">
                    <VerticalStackLayout Spacing="{StaticResource SpaceSm}" HorizontalOptions="Center" IsVisible="{Binding IsNoGame}">
                        <Border Style="{StaticResource IconTileSurface}" HorizontalOptions="Center">
                            <Label Text="{x:Static fonts:FontAwesomeGlyphs.Futbol}" FontFamily="FontAwesomeSolid" Style="{StaticResource BrandIconLabel}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="{x:Static pageModels:GameDayPageModel.NoGameMessage}" Style="{StaticResource TextCaption}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="{StaticResource SpaceSm}" IsVisible="{Binding IsShowingRecentGames}">
                        <c:SectionHeader Text="Your recent games" />
                        <Label Text="Newest first - tap a game to review its summary." Style="{StaticResource TextCaption}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentGameSummaries}" Spacing="{StaticResource SpaceSm}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="pageModels:RecentGameSummaryItem">
                                    <c:PlayerRow
                                        Glyph="{x:Static fonts:FontAwesomeGlyphs.Futbol}"
                                        Name="{Binding Summary.Title}"
                                        Detail="{Binding ContextLabel}"
                                        TrailingText="{Binding Summary.DateLabel}"
                                        SemanticDescription="{Binding AccessibilityDescription}"
                                        TapCommand="{Binding Source={x:Reference GameDay}, Path=BindingContext.SelectRecentGameCommand}"
                                        TapCommandParameter="{Binding .}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="{StaticResource SpaceSm}" IsVisible="{Binding HasLastGame}">
                        <c:SectionHeader Text="Game summary" />
                        <c:BrandCard>
                            <VerticalStackLayout Spacing="{StaticResource SpaceSm}">
                                <Label Text="{Binding LastGame.Title}" Style="{StaticResource TextH2}" />
                                <HorizontalStackLayout Spacing="{StaticResource SpaceSm}">
                                    <Border Style="{StaticResource MetadataChip}" IsVisible="{Binding HasLastGameGroup}">
                                        <Label Text="{Binding LastGame.GroupName}" Style="{StaticResource TextCaption}" />
                                    </Border>
                                    <Border Style="{StaticResource MetadataChip}">
                                        <Label Text="{Binding LastGame.Venue}" Style="{StaticResource TextCaption}" />
                                    </Border>
                                    <Border Style="{StaticResource MetadataChip}">
                                        <Label Text="{Binding LastGame.DateLabel}" Style="{StaticResource TextCaption}" />
                                    </Border>
                                </HorizontalStackLayout>
                                <Label Text="{Binding LastGameCountsLabel}" Style="{StaticResource TextBodyStrong}" />
                                <Label Text="{Binding LastGame.ResultSummary}" Style="{StaticResource TextCaption}" IsVisible="{Binding HasLastGameResult}" />
                            </VerticalStackLayout>
                        </c:BrandCard>
                        <!-- Team sheets: tap a captain's card to see approved goal/assist icon tallies. -->
                        <VerticalStackLayout Spacing="{StaticResource SpaceSm}" IsVisible="{Binding HasLastGameTeams}">
                            <c:SectionHeader Text="Teams" />
                            <Label Text="Tap a team to see its players, goals, and assists." Style="{StaticResource TextCaption}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding LastGameTeams}" Spacing="{StaticResource SpaceSm}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="gameDay:LastGameTeamDto">
                                        <Border Style="{StaticResource CardSurface}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding BindingContext.ShowLastGameTeamCommand, Source={x:Reference GameDay}}" CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                                                <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                                                    <Label Text="{Binding Name}" Style="{StaticResource TextBodyStrong}" />
                                                    <Label Text="{Binding CaptainName, StringFormat='Captain: {0}'}" Style="{StaticResource TextCaption}" />
                                                </VerticalStackLayout>
                                                <Label
                                                    Grid.Column="1"
                                                    VerticalOptions="Center"
                                                    Text="{Binding ResultLabel}"
                                                    Style="{StaticResource TextBodyStrong}"
                                                    SemanticProperties.Description="{Binding Name, StringFormat='{0} result'}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                        <!-- Rating is open to eligible players; the remaining actions are role-gated. -->
                        <c:SectionHeader Text="Finish up this game" IsVisible="{Binding HasLastGameActions}" />
                        <c:PlayerRow Glyph="{x:Static fonts:FontAwesomeGlyphs.Star}" Name="Rate teammates" Detail="Rate, like, and pick one MVP" TapCommand="{Binding OpenLastGameRatingsCommand}" IsVisible="{Binding LastGameCanRateTeammates}" SemanticProperties.Hint="Opens teammate ratings for the last game" />
                        <c:PlayerRow Glyph="{x:Static fonts:FontAwesomeGlyphs.Lock}" Name="Lock the teams" Detail="Teams were never locked - assign captains and lock" TapCommand="{Binding OpenLastGameCaptainsCommand}" IsVisible="{Binding LastGameCanLockTeams}" />
                        <c:PlayerRow Glyph="{x:Static fonts:FontAwesomeGlyphs.Users}" Name="Match players" Detail="Link imported names to profiles" TapCommand="{Binding OpenLastGameMatchPlayersCommand}" IsVisible="{Binding LastGameCanMatchPlayers}" />
                        <c:PlayerRow Glyph="{x:Static fonts:FontAwesomeGlyphs.CircleCheck}" Name="Confirm result and goals" Detail="Approve the team win/loss and each goal" TapCommand="{Binding OpenLastGameApprovalCommand}" IsVisible="{Binding LastGameCanApprovePostGame}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        </RefreshView>
    </c:StateView>
</ContentPage>
