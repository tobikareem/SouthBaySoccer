<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SouthBaySoccer.Pages.GameDayPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:SouthBaySoccer.Controls"
    xmlns:fonts="clr-namespace:Fonts"
    xmlns:pageModels="clr-namespace:SouthBaySoccer.PageModels"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="GameDay"
    x:DataType="pageModels:GameDayPageModel"
    Shell.NavBarIsVisible="False"
    Style="{StaticResource BrandPage}"
    Title="Game Day">
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference GameDay}, x:DataType=ContentPage}"
            EventName="Appearing"
            Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>
    <c:StateView State="{Binding State}" Title="{Binding StateTitle}" Message="{Binding StateMessage}" Glyph="{x:Static fonts:FontAwesomeGlyphs.Futbol}" GlyphFontFamily="FontAwesomeSolid" RetryCommand="{Binding RetryCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="{StaticResource SpaceMd}">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                        <Label Text="{Binding Venue, StringFormat='Today - {0}'}" Style="{StaticResource TextCaption}" />
                        <Label Text="Game Day" Style="{StaticResource TextH1}" SemanticProperties.HeadingLevel="Level1" />
                    </VerticalStackLayout>
                    <c:Badge Grid.Column="1" Text="{Binding StatusLabel}" Glyph="{x:Static fonts:FontAwesomeGlyphs.Clock}" Variant="Success" />
                </Grid>
                <c:BrandCard IsHero="True">
                    <VerticalStackLayout Spacing="{StaticResource SpaceMd}">
                        <Label Text="Check-in window" Style="{StaticResource TextLabel}" TextColor="White" />
                        <Label Text="{Binding CheckInWindowLabel}" Style="{StaticResource TextDisplay}" TextColor="White" />
                        <HorizontalStackLayout Spacing="{StaticResource SpaceSm}">
                            <Border Style="{StaticResource MetadataChip}" BackgroundColor="{StaticResource HeaderOverlay}">
                                <Label Text="{Binding GameStartLabel, StringFormat='Game starts {0}'}" Style="{StaticResource TextCaption}" TextColor="White" />
                            </Border>
                            <Border Style="{StaticResource MetadataChip}" BackgroundColor="{StaticResource HeaderOverlay}">
                                <Label Text="{Binding CheckInCloseLabel}" Style="{StaticResource TextCaption}" TextColor="White" />
                            </Border>
                        </HorizontalStackLayout>
                        <Button Text="{Binding PrimaryActionText}" Command="{Binding CheckInCommand}" BackgroundColor="White" TextColor="{StaticResource BrandGreenLight}" Style="{StaticResource GhostButton}" SemanticProperties.Description="{Binding PrimaryActionText}" />
                    </VerticalStackLayout>
                </c:BrandCard>
                <Label Text="{Binding BlockReason}" Style="{StaticResource TextCaption}" IsVisible="{Binding HasBlockReason}" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource SpaceSm}">
                    <c:StatTile Value="{Binding GoingCount}" Label="Going" />
                    <c:StatTile Grid.Column="1" Value="{Binding CheckedInCount}" Label="Checked in" />
                    <c:StatTile Grid.Column="2" Value="{Binding LateCount}" Label="Late" />
                </Grid>
                <Border Style="{StaticResource NoticeSurface}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceSm}">
                        <Label Text="{x:Static fonts:FontAwesomeGlyphs.CircleInfo}" FontFamily="FontAwesomeSolid" Style="{StaticResource BrandIconLabel}" />
                        <Label Grid.Column="1" Text="{x:Static pageModels:GameDayPageModel.NoticeText}" Style="{StaticResource TextCaption}" />
                    </Grid>
                </Border>
                <c:SectionHeader Text="Game-day actions" IsVisible="{Binding HasGameDayActions}" />
                <c:PlayerRow Initials="CA" Name="Assign captains" Detail="2, 3, or 4 captains = 2, 3, or 4 teams" TapCommand="{Binding OpenCaptainAssignmentCommand}" IsVisible="{Binding CanAssignCaptains}" />
                <c:PlayerRow Initials="DR" Name="Pick your team" Detail="Captain permission - session scoped" TapCommand="{Binding OpenTeamDraftCommand}" IsVisible="{Binding CanDraftTeam}" />
                <c:PlayerRow Initials="PG" Name="Approve stats and result" Detail="After game - captains only" TapCommand="{Binding OpenPostGameApprovalCommand}" IsVisible="{Binding CanApprovePostGame}" />
            </VerticalStackLayout>
        </ScrollView>
    </c:StateView>
</ContentPage>

