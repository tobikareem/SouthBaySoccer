<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SouthBaySoccer.Pages.TeamDraftPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:SouthBaySoccer.Controls"
    xmlns:fonts="clr-namespace:Fonts"
    xmlns:pageModels="clr-namespace:SouthBaySoccer.PageModels"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="DraftPage"
    x:DataType="pageModels:TeamDraftPageModel"
    Shell.NavBarIsVisible="False"
    Style="{StaticResource BrandPage}"
    Title="Pick team">
    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior BindingContext="{Binding Path=BindingContext, Source={x:Reference DraftPage}, x:DataType=ContentPage}" EventName="Appearing" Command="{Binding AppearingCommand}" />
        <toolkit:EventToCommandBehavior BindingContext="{Binding Path=BindingContext, Source={x:Reference DraftPage}, x:DataType=ContentPage}" EventName="Disappearing" Command="{Binding DisappearingCommand}" />
    </ContentPage.Behaviors>
    <Grid RowDefinitions="Auto,*">
        <c:BrandHeader Title="Pick team" Subtitle="{Binding CaptainName, StringFormat='Captain - {0}'}" ShowBack="True" BackCommand="{Binding BackCommand}" />
        <c:StateView Grid.Row="1" State="{Binding State}" Title="{Binding StateTitle}" Message="{Binding StateMessage}" RetryCommand="{Binding RetryCommand}" Glyph="{x:Static fonts:FontAwesomeGlyphs.Users}" GlyphFontFamily="FontAwesomeSolid">
            <ScrollView>
                <VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="{StaticResource SpaceMd}">
                    <!-- Snake-turn banner: always tells everyone whose pick it is, no training needed. -->
                    <Border Style="{StaticResource NoticeSurface}" IsVisible="{Binding HasTurnBanner}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceSm}">
                            <Label Text="{x:Static fonts:FontAwesomeGlyphs.Clock}" FontFamily="FontAwesomeSolid" Style="{StaticResource BrandIconLabel}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding OnTheClockLabel}" Style="{StaticResource TextBodyStrong}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <VerticalStackLayout Spacing="{StaticResource SpaceSm}" IsVisible="{Binding CanManageAllTeams}">
                        <!-- Admin-only: replaces every team with a rating-balanced deal; tapping again re-deals. -->
                        <Button Text="Auto-balance teams" Command="{Binding AutoBalanceCommand}" Style="{StaticResource SecondaryButton}" />
                        <c:SectionHeader Text="Drafting for" />
                        <ScrollView Orientation="Horizontal">
                            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Teams}" Spacing="{StaticResource SpaceSm}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="pageModels:DraftTeamOption">
                                        <Button
                                            Text="{Binding Name}"
                                            Command="{Binding BindingContext.SelectTeamCommand, Source={x:Reference DraftPage}}"
                                            CommandParameter="{Binding TeamId}"
                                            Style="{StaticResource SecondaryButton}"
                                            SemanticProperties.Description="{Binding Name, StringFormat='Draft for {0}'}">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Style" Value="{StaticResource PrimaryButton}" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>
                    <c:BrandCard>
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="{Binding TeamName}" Style="{StaticResource TextBodyStrong}" />
                                <Label Text="{Binding Summary}" Style="{StaticResource TextCaption}" />
                            </VerticalStackLayout>
                            <c:Badge Grid.Column="1" Text="Captain pick" Glyph="{x:Static fonts:FontAwesomeGlyphs.ShieldHalved}" Variant="Success" IsVisible="{Binding CanPickPlayers}" />
                        </Grid>
                    </c:BrandCard>
                    <Entry Text="{Binding SearchText}" Placeholder="Search confirmed roster" Style="{StaticResource BrandEntry}" SemanticProperties.Description="Search the confirmed roster" />
                    <c:SectionHeader Text="Confirmed roster (Going &amp; Waitlist)" />
                    <c:BrandCard>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Players}" Spacing="{StaticResource SpaceXs}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="pageModels:DraftPlayerItem">
                                    <c:PlayerRow Initials="{Binding Initials}" Name="{Binding Name}" Detail="{Binding Detail}" SemanticDescription="{Binding SemanticLabel}" TapCommand="{Binding BindingContext.TogglePickCommand, Source={x:Reference DraftPage}}" TapCommandParameter="{Binding .}" IsEnabled="{Binding IsPickable}" IsVisible="{Binding IsVisible}">
                                        <!-- Grey players taken by another team or blocked by this team's cap. -->
                                        <c:PlayerRow.Triggers>
                                            <DataTrigger TargetType="c:PlayerRow" Binding="{Binding IsDimmed}" Value="True">
                                                <Setter Property="Opacity" Value="0.4" />
                                            </DataTrigger>
                                        </c:PlayerRow.Triggers>
                                        <c:PlayerRow.TrailingContent>
                                            <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsPickable}" InputTransparent="True" AutomationProperties.IsInAccessibleTree="False" />
                                        </c:PlayerRow.TrailingContent>
                                    </c:PlayerRow>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </c:BrandCard>
                    <Border Style="{StaticResource NoticeSurface}" IsVisible="{Binding IsLocked}">
                        <Label Text="Teams are locked. Picks are now read-only." Style="{StaticResource TextCaption}" />
                    </Border>
                    <!-- Bulk save is the admin's correction tool; captains draft one pick at a time on
                         their turn, so they never see this button. IsEnabled is driven by
                         SaveCommand.CanExecute so it greys out after it is tapped. -->
                    <Button Text="Save team picks" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" IsVisible="{Binding CanManageAllTeams}" />
                    <Label Text="Captains: tap a player on your turn to pick them." Style="{StaticResource TextCaption}" HorizontalTextAlignment="Center" IsVisible="{Binding CanManageAllTeams, Converter={StaticResource InvertedBoolConverter}}" />
                    <Label Text="Permission expires when teams lock." Style="{StaticResource TextCaption}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </ScrollView>
        </c:StateView>
    </Grid>
</ContentPage>
