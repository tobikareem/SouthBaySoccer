<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SouthBaySoccer.Pages.SignUpWelcomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:SouthBaySoccer.Controls"
    xmlns:fonts="clr-namespace:Fonts"
    xmlns:pageModels="clr-namespace:SouthBaySoccer.PageModels"
    x:DataType="pageModels:SignUpWelcomePageModel"
    NavigationPage.HasNavigationBar="False"
    Style="{StaticResource BrandPage}"
    Title="Welcome">

    <Grid RowDefinitions="Auto,*">
        <c:BrandHeader Title="{Binding Heading}"
                       Subtitle="{x:Static pageModels:SignUpWelcomePageModel.Subtitle}" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="{StaticResource WelcomeContentPadding}"
                                 Spacing="{StaticResource SpaceMd}">
                <Border Style="{StaticResource CardSurface}">
                    <VerticalStackLayout Spacing="{StaticResource SpaceMd}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceMd}">
                            <Label Text="{x:Static fonts:FontAwesomeGlyphs.CircleCheck}" FontFamily="FontAwesomeSolid"
                                   FontSize="{StaticResource IconLg}" TextColor="{AppThemeBinding Light={StaticResource BrandGreenLight}, Dark={StaticResource BrandGreenDarkTheme}}"
                                   VerticalTextAlignment="Center" SemanticProperties.Description="Done" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="{x:Static pageModels:SignUpWelcomePageModel.PhoneLinkedTitle}" Style="{StaticResource TextBodyStrong}" />
                                <Label Text="{Binding PhoneLinkedDetail}" Style="{StaticResource TextCaption}" />
                            </VerticalStackLayout>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceMd}">
                            <Label Text="{x:Static fonts:FontAwesomeGlyphs.Users}" FontFamily="FontAwesomeSolid"
                                   FontSize="{StaticResource IconLg}" TextColor="{AppThemeBinding Light={StaticResource BrandGreenLight}, Dark={StaticResource BrandGreenDarkTheme}}"
                                   VerticalTextAlignment="Center" SemanticProperties.Description="Group" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="{Binding GroupTitle}" Style="{StaticResource TextBodyStrong}" />
                                <Label Text="{Binding GroupDetail}" Style="{StaticResource TextCaption}" />
                            </VerticalStackLayout>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceMd}" IsVisible="{Binding HistoryPending}">
                            <Label Text="{x:Static fonts:FontAwesomeGlyphs.Clock}" FontFamily="FontAwesomeSolid"
                                   FontSize="{StaticResource IconLg}" TextColor="{AppThemeBinding Light={StaticResource WarningLight}, Dark={StaticResource WarningDark}}"
                                   VerticalTextAlignment="Center" SemanticProperties.Description="Pending" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="{x:Static pageModels:SignUpWelcomePageModel.HistoryPendingTitle}" Style="{StaticResource TextBodyStrong}" />
                                <Label Text="{x:Static pageModels:SignUpWelcomePageModel.HistoryPendingDetail}" Style="{StaticResource TextCaption}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <c:SectionHeader Text="{x:Static pageModels:SignUpWelcomePageModel.BeforeFirstRsvpLabel}" />

                <c:BrandCard SemanticProperties.Description="{x:Static pageModels:SignUpWelcomePageModel.WaiverTitle}">
                    <c:BrandCard.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ContinueCommand}" />
                    </c:BrandCard.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SpaceMd}">
                        <Border Style="{StaticResource IconTileSurface}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenLight}, Dark={StaticResource BrandGreenDarkTheme}}">
                            <Label Text="{x:Static fonts:FontAwesomeGlyphs.ShieldHalved}" FontFamily="FontAwesomeSolid"
                                   TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="{x:Static pageModels:SignUpWelcomePageModel.WaiverTitle}" Style="{StaticResource TextBodyStrong}" />
                            <Label Text="{x:Static pageModels:SignUpWelcomePageModel.WaiverDetail}" Style="{StaticResource TextCaption}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="{x:Static fonts:FontAwesomeGlyphs.ChevronRight}" FontFamily="FontAwesomeSolid"
                               TextColor="{AppThemeBinding Light={StaticResource BrandSageLight}, Dark={StaticResource BrandSageDark}}"
                               VerticalTextAlignment="Center" />
                    </Grid>
                </c:BrandCard>

                <Label Text="{Binding StatusMessage}"
                       Style="{StaticResource TextCaption}"
                       TextColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}"
                       HorizontalTextAlignment="Center"
                       IsVisible="{Binding HasStatusMessage}" />

                <Grid>
                    <Button Text="See upcoming sessions"
                            Command="{Binding ContinueCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            Style="{StaticResource PrimaryButton}"
                            SemanticProperties.Description="Continue to sessions" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="White"
                                       HorizontalOptions="End" Margin="{StaticResource WelcomeButtonBusyMargin}" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
