<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SouthBaySoccer.Pages.SignUpDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:SouthBaySoccer.Controls"
    xmlns:fonts="clr-namespace:Fonts"
    xmlns:pageModels="clr-namespace:SouthBaySoccer.PageModels"
    x:DataType="pageModels:SignUpDetailsPageModel"
    NavigationPage.HasNavigationBar="False"
    Style="{StaticResource BrandPage}"
    Title="{x:Static pageModels:SignUpDetailsPageModel.Title}">

    <Grid RowDefinitions="Auto,*">
        <c:BrandHeader Title="{x:Static pageModels:SignUpDetailsPageModel.Title}"
                       Subtitle="{x:Static pageModels:SignUpDetailsPageModel.StepLabel}"
                       ShowBack="True"
                       BackCommand="{Binding GoBackCommand}" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="{StaticResource WelcomeContentPadding}"
                                 Spacing="{StaticResource SpaceMd}">
                <Border Style="{StaticResource NoticeSurface}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceSm}">
                        <Label Text="{x:Static fonts:FontAwesomeGlyphs.CircleCheck}"
                               FontFamily="FontAwesomeSolid"
                               FontSize="{StaticResource IconMd}"
                               TextColor="{AppThemeBinding Light={StaticResource BrandGreenDepthLight}, Dark={StaticResource BrandSpringDark}}"
                               AutomationProperties.IsInAccessibleTree="False" />
                        <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource SpaceXs}">
                            <Label Text="{x:Static pageModels:SignUpDetailsPageModel.ConfirmedHeading}" Style="{StaticResource TextBodyStrong}" />
                            <Label Text="{Binding ConfirmedMessage}" Style="{StaticResource TextCaption}" LineHeight="1.4" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpaceSm}">
                    <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                        <Label Text="First name" Style="{StaticResource TextLabel}" />
                        <Entry Text="{Binding FirstName}" Style="{StaticResource BrandEntry}" Placeholder="Ada"
                               ReturnType="Next" SemanticProperties.Description="First name" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource SpaceXs}">
                        <Label Text="Last name" Style="{StaticResource TextLabel}" />
                        <Entry Text="{Binding LastName}" Style="{StaticResource BrandEntry}" Placeholder="Okafor"
                               ReturnType="Next" SemanticProperties.Description="Last name" />
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                    <Label Text="Email" Style="{StaticResource TextLabel}" />
                    <Entry Text="{Binding Email}" Style="{StaticResource BrandEntry}" Keyboard="Email"
                           Placeholder="you@example.com" ReturnType="Next" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                           SemanticProperties.Description="Email address" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceXs}" IsVisible="{Binding HasEmailError}">
                        <Label Text="{Binding EmailError}"
                               Style="{StaticResource TextCaption}"
                               TextColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}"
                               VerticalTextAlignment="Center"
                               LineBreakMode="WordWrap" />
                        <Button Grid.Column="1" Text="Sign in instead?" Command="{Binding SignInInsteadCommand}" Style="{StaticResource LinkButton}"
                                IsVisible="{Binding IsEmailTaken}"
                                SemanticProperties.Description="Sign in with the existing account instead" />
                    </Grid>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                    <Label Text="Password" Style="{StaticResource TextLabel}" />
                    <Entry Text="{Binding Password}" Style="{StaticResource BrandEntry}" IsPassword="True"
                           ReturnType="Done" SemanticProperties.Description="Password"
                           SemanticProperties.Hint="{x:Static pageModels:SignUpDetailsPageModel.PasswordHint}" />
                    <Label Text="{x:Static pageModels:SignUpDetailsPageModel.PasswordHint}" Style="{StaticResource TextCaption}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                    <Label Text="Position (optional)" Style="{StaticResource TextLabel}" />
                    <CollectionView ItemsSource="{Binding Positions}"
                                    SelectionMode="None"
                                    MinimumHeightRequest="{StaticResource TouchMin}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="{StaticResource SpaceXs}" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="pageModels:PositionOption">
                                <Border Style="{StaticResource SelectableChip}"
                                        SemanticProperties.Description="{Binding Name, StringFormat='{0}, tap to select or clear'}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding TogglePositionCommand, Source={RelativeSource Mode=FindAncestorBindingContext, AncestorType={x:Type pageModels:SignUpDetailsPageModel}}}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding Code}" Style="{StaticResource TextBodyStrong}"
                                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <c:ToggleRow Glyph="{x:Static fonts:FontAwesomeGlyphs.ShieldHalved}"
                             GlyphFontFamily="FontAwesomeSolid"
                             Title="{x:Static pageModels:SignUpDetailsPageModel.TermsTitle}"
                             Subtitle="{x:Static pageModels:SignUpDetailsPageModel.TermsSubtitle}"
                             IsToggled="{Binding TermsAccepted, Mode=TwoWay}" />
                <HorizontalStackLayout Spacing="{StaticResource SpaceSm}">
                    <Button Text="Pickup Pal terms" Command="{Binding OpenTermsCommand}" Style="{StaticResource LinkButton}"
                            SemanticProperties.Description="Open the Pickup Pal terms" />
                    <Button Text="N9ja Bay privacy policy" Command="{Binding OpenPrivacyPolicyCommand}" Style="{StaticResource LinkButton}"
                            SemanticProperties.Description="Open the N9ja Bay privacy policy" />
                </HorizontalStackLayout>

                <Label Text="{Binding FormError}"
                       Style="{StaticResource TextCaption}"
                       TextColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}"
                       IsVisible="{Binding HasFormError}" />

                <Grid>
                    <Button Text="Create account"
                            Command="{Binding CreateAccountCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            Style="{StaticResource PrimaryButton}"
                            SemanticProperties.Description="Create account" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource BrandWhite}"
                                       HorizontalOptions="End" Margin="{StaticResource WelcomeButtonBusyMargin}" />
                </Grid>

                <Label Text="{x:Static pageModels:SignUpDetailsPageModel.NextStepHint}"
                       Style="{StaticResource TextCaption}"
                       HorizontalTextAlignment="Center"
                       LineHeight="1.5" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
