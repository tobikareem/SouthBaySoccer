<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SouthBaySoccer.Pages.AdminBroadcastPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:announcements="clr-namespace:SouthBaySoccer.Contracts.Announcements;assembly=SouthBaySoccer.Contracts"
    xmlns:controls="clr-namespace:SouthBaySoccer.Controls"
    xmlns:fonts="clr-namespace:Fonts"
    xmlns:pageModels="clr-namespace:SouthBaySoccer.PageModels"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="Page"
    x:DataType="pageModels:AdminBroadcastPageModel"
    Shell.NavBarIsVisible="False"
    Style="{StaticResource BrandPage}">
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding BindingContext, Source={x:Reference Page}, x:DataType=ContentPage}"
            EventName="Appearing"
            Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>
    <Grid RowDefinitions="Auto,*,Auto">
        <controls:BrandHeader Title="Broadcast message"
                              Subtitle="Admin only"
                              ShowBack="True"
                              BackCommand="{Binding BackCommand}" />
        <controls:StateView Grid.Row="1"
                            State="{Binding State}"
                            Title="{Binding StateTitle}"
                            Message="{Binding StateMessage}"
                            RetryCommand="{Binding AppearingCommand}">
            <ScrollView>
                <VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="{StaticResource SpaceLg}">
                    <VerticalStackLayout Spacing="{StaticResource SpaceSm}">
                        <Label Text="Send to one group" Style="{StaticResource TextLabel}" />
                        <!-- HeightRequest is required, not cosmetic: a horizontally-scrolling
                             CollectionView inside a ScrollView has no bounded height, so without it
                             the picker expands to fill the page and pushes the composer, preview and
                             send button off-screen. Sized for the two-line GroupChoiceRow. -->
                        <CollectionView ItemsSource="{Binding Groups}"
                                        HeightRequest="88"
                                        SelectionMode="None"
                                        SemanticProperties.Description="Broadcast audience">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="{StaticResource SpaceSm}" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="pageModels:GroupChoiceViewModel">
                                    <controls:GroupChoiceRow GroupName="{Binding GroupName}"
                                                             MemberCount="{Binding MemberCount}"
                                                             IsSelected="{Binding IsSelected}">
                                        <controls:GroupChoiceRow.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding BindingContext.SelectGroupCommand, Source={x:Reference Page}, x:DataType=ContentPage}"
                                                CommandParameter="{Binding .}" />
                                        </controls:GroupChoiceRow.GestureRecognizers>
                                    </controls:GroupChoiceRow>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="{StaticResource SpaceSm}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Message" Style="{StaticResource TextLabel}" />
                            <Label Grid.Column="1" Text="{Binding CharacterCountLabel}" Style="{StaticResource TextCaption}" />
                        </Grid>
                        <Editor Text="{Binding Body}"
                                MaxLength="500"
                                IsEnabled="{Binding IsComposerEnabled}"
                                Placeholder="Share a game update with your group"
                                SemanticProperties.Description="Broadcast message, maximum 500 characters" />
                        <Label Text="{Binding InlineError}"
                               TextColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}"
                               Style="{StaticResource TextCaption}"
                               SemanticProperties.Description="{Binding InlineError}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding InlineError}" Value="">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="{StaticResource SpaceMd}">
                        <Label Text="How it lands" Style="{StaticResource TextLabel}" />
                        <controls:AnnouncementCard AuthorName="Admin"
                                                   GroupName="{Binding PreviewGroupName}"
                                                   TimeLabel="Now"
                                                   Body="{Binding PreviewBody}" />
                        <controls:ToggleRow Glyph="{x:Static fonts:FontAwesomeGlyphs.Bell}"
                                            GlyphFontFamily="FontAwesomeSolid"
                                            Title="Send a push notification"
                                            Subtitle="Players still receive this in the app."
                                            IsToggled="{Binding SendPush}"
                                            IsEnabled="{Binding IsComposerEnabled}" />
                        <controls:PushPreview Title="{Binding PushTitle}"
                                              Body="{Binding PreviewBody}"
                                              IsVisible="{Binding SendPush}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentlySent}" Spacing="{StaticResource SpaceSm}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="announcements:SentAnnouncementDto">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Body}" MaxLines="2" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding GroupName}" Style="{StaticResource TextCaption}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding ReadCount, StringFormat='{}{0} seen'}" Style="{StaticResource TextCaption}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </controls:StateView>
        <VerticalStackLayout Grid.Row="2" Padding="{StaticResource LayoutPadding}" Spacing="{StaticResource SpaceXs}">
            <Button Text="{Binding BroadcastLabel}" Command="{Binding SendCommand}" Style="{StaticResource PrimaryButton}" />
            <Label Text="Broadcasts cannot be edited after sending."
                   HorizontalTextAlignment="Center"
                   Style="{StaticResource TextCaption}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
