<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SouthBaySoccer.Pages.StatsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:SouthBaySoccer.Controls"
    xmlns:fonts="clr-namespace:Fonts"
    Shell.NavBarIsVisible="False"
    Style="{StaticResource BrandPage}"
    Title="Stats">

    <Grid RowDefinitions="Auto,*">
        <c:BrandHeader Grid.Row="0"
                       Title="Stats"
                       Subtitle="Season 2026" />

        <VerticalStackLayout Grid.Row="1"
                             Padding="{StaticResource WelcomeContentPadding}"
                             Spacing="{StaticResource SpaceMd}"
                             HorizontalOptions="Center"
                             VerticalOptions="Center">
            <Label Text="{x:Static fonts:FontAwesomeGlyphs.Trophy}"
                   FontFamily="FontAwesomeSolid"
                   Style="{StaticResource TextDisplay}"
                   TextColor="{AppThemeBinding Light={StaticResource BrandGreenLight}, Dark={StaticResource BrandSpringDark}}"
                   HorizontalTextAlignment="Center" />
            <Label Text="Leaderboards and your stats"
                   Style="{StaticResource TextH2}"
                   HorizontalTextAlignment="Center"
                   SemanticProperties.HeadingLevel="Level2" />
            <Label Text="Goals, assists and league tables land here soon."
                   Style="{StaticResource TextCaption}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
