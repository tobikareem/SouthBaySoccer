<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SouthBaySoccer.Pages.StatsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:SouthBaySoccer.Controls"
    xmlns:fonts="clr-namespace:Fonts"
    Shell.NavBarIsVisible="False"
    Style="{StaticResource BrandPage}"
    Title="Stats">

    <Grid RowDefinitions="Auto,*">
        <c:BrandHeader Grid.Row="0"
                       Title="Stats"
                       Subtitle="Season 2026" />

        <c:StateView Grid.Row="1"
                     State="Empty"
                     Title="Stats are coming soon"
                     Message="Goals, assists, ratings, and league tables will appear here."
                     Glyph="{x:Static fonts:FontAwesomeGlyphs.Trophy}"
                     GlyphFontFamily="FontAwesomeSolid" />
    </Grid>
</ContentPage>
