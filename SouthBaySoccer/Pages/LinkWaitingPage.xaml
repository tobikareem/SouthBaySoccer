<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SouthBaySoccer.Pages.LinkWaitingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:SouthBaySoccer.Controls"
    xmlns:fonts="clr-namespace:Fonts"
    xmlns:pageModels="clr-namespace:SouthBaySoccer.PageModels"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="LinkWaitingPageName"
    x:DataType="pageModels:LinkWaitingPageModel"
    NavigationPage.HasNavigationBar="False"
    Style="{StaticResource BrandPage}"
    Title="{x:Static pageModels:LinkWaitingPageModel.Title}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference LinkWaitingPageName}, x:DataType=ContentPage}"
            EventName="Appearing"
            Command="{Binding AppearingCommand}" />
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference LinkWaitingPageName}, x:DataType=ContentPage}"
            EventName="Disappearing"
            Command="{Binding DisappearingCommand}" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*">
        <c:BrandHeader Title="{x:Static pageModels:LinkWaitingPageModel.Title}"
                       Subtitle="{Binding StepLabel}"
                       ShowBack="True"
                       BackCommand="{Binding GoBackCommand}" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="{StaticResource WelcomeContentPadding}"
                                 Spacing="{StaticResource SpaceMd}">
                <Border Style="{StaticResource IconTileSurface}"
                        HeightRequest="{StaticResource HeroTileSize}" WidthRequest="{StaticResource HeroTileSize}"
                        StrokeShape="{StaticResource ShapePill}"
                        HorizontalOptions="Center">
                    <Label Text="{x:Static fonts:FontAwesomeGlyphs.WhatsApp}"
                           FontFamily="FontAwesomeBrands"
                           FontSize="{StaticResource HeroGlyphSize}"
                           TextColor="{StaticResource WhatsApp}"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           SemanticProperties.Description="WhatsApp" />
                </Border>

                <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                    <Label Text="{x:Static pageModels:LinkWaitingPageModel.Heading}"
                           Style="{StaticResource TextH1}"
                           HorizontalTextAlignment="Center"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="{Binding Description}"
                           Style="{StaticResource TextCaption}"
                           HorizontalTextAlignment="Center"
                           LineHeight="1.5" />
                </VerticalStackLayout>

                <c:LinkExpiryCard RemainingText="{Binding RemainingText}"
                                  RemainingPercent="{Binding RemainingPercent}"
                                  Note="{Binding ExpiryNote}" />

                <Border Style="{StaticResource NoticeSurface}" IsVisible="{Binding HasExpired}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceSm}">
                        <Label Text="{x:Static fonts:FontAwesomeGlyphs.Clock}"
                               FontFamily="FontAwesomeSolid"
                               FontSize="{StaticResource IconMd}"
                               TextColor="{AppThemeBinding Light={StaticResource WarningLight}, Dark={StaticResource WarningDark}}"
                               AutomationProperties.IsInAccessibleTree="False" />
                        <Label Grid.Column="1" Text="{Binding ExpiredHint}" Style="{StaticResource TextCaption}" LineHeight="1.4" />
                    </Grid>
                </Border>

                <Grid IsVisible="{Binding HasNotExpired}">
                    <Button Text="Open WhatsApp again"
                            Command="{Binding OpenWhatsAppAgainCommand}"
                            Style="{StaticResource WhatsAppButton}"
                            SemanticProperties.Description="Open WhatsApp again" />
                    <Label Text="{x:Static fonts:FontAwesomeGlyphs.WhatsApp}"
                           FontFamily="FontAwesomeBrands"
                           FontSize="{StaticResource IconMd}"
                           TextColor="{StaticResource BrandWhite}"
                           HorizontalOptions="Start"
                           Margin="{StaticResource WelcomeButtonIconMargin}"
                           VerticalTextAlignment="Center"
                           InputTransparent="True" />
                </Grid>

                <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                    <Entry Text="{Binding PastedLinkText}"
                           Placeholder="{x:Static pageModels:LinkWaitingPageModel.PasteLinkPlaceholder}"
                           Keyboard="Url"
                           ReturnType="Go"
                           ReturnCommand="{Binding PasteLinkCommand}"
                           Style="{StaticResource BrandEntry}"
                           SemanticProperties.Description="Paste the link from the bot" />
                    <Button Text="Use this link"
                            Command="{Binding PasteLinkCommand}"
                            Style="{StaticResource GhostButton}"
                            SemanticProperties.Description="Continue with the pasted link" />
                </VerticalStackLayout>

                <Label Text="{Binding StatusMessage}"
                       Style="{StaticResource TextCaption}"
                       TextColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}"
                       HorizontalTextAlignment="Center"
                       IsVisible="{Binding HasStatusMessage}" />

                <Label Text="{Binding NoReplyHint}"
                       Style="{StaticResource TextCaption}"
                       HorizontalTextAlignment="Center"
                       LineHeight="1.5" />

                <Button Text="{Binding ExpiredActionText}"
                        Command="{Binding LinkExpiredCommand}"
                        Style="{StaticResource LinkButton}"
                        HorizontalOptions="Center"
                        SemanticProperties.Description="The link expired, get a new one" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
