<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SouthBaySoccer.Pages.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:SouthBaySoccer.Controls"
    xmlns:fonts="clr-namespace:Fonts"
    xmlns:pageModels="clr-namespace:SouthBaySoccer.PageModels"
    xmlns:profiles="clr-namespace:SouthBaySoccer.Contracts.Profiles;assembly=SouthBaySoccer.Contracts"
    xmlns:local="clr-namespace:SouthBaySoccer.Utilities"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="ProfilePageName"
    x:DataType="pageModels:ProfilePageModel"
    Shell.NavBarIsVisible="False"
    Style="{StaticResource BrandPage}"
    Title="Profile">

    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="InvertedBool" />
        <local:MatchResultConverter x:Key="MatchResultConverter" />
        <local:MatchResultVariantConverter x:Key="MatchResultVariantConverter" />
        <local:MatchResultDescriptionConverter x:Key="MatchResultDescriptionConverter" />
    </ContentPage.Resources>

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference ProfilePageName}, x:DataType=ContentPage}"
            EventName="Appearing"
            Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*">
        <!-- Brand header with avatar in LeadingContent -->
        <c:BrandHeader Grid.Row="0">
            <c:BrandHeader.LeadingContent>
                <c:Avatar
                    Initials="{Binding Profile.Initials, Source={x:Reference ProfilePageName}}"
                    Size="54"
                    Variant="OnGreen"
                    Description="Player avatar" />
            </c:BrandHeader.LeadingContent>

            <!-- Bind title/subtitle from profile -->
            <c:BrandHeader.Content>
                <VerticalStackLayout Spacing="0">
                    <Label Text="{Binding Profile.DisplayName, Source={x:Reference ProfilePageName}}"
                           Style="{StaticResource TextH2}"
                           TextColor="White"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="{Binding Profile.Subtitle, Source={x:Reference ProfilePageName}}"
                           Style="{StaticResource TextCaption}"
                           TextColor="White"
                           Opacity="0.85" />
                </VerticalStackLayout>
            </c:BrandHeader.Content>
        </c:BrandHeader>

        <!-- StateView for loading / content / empty / error / offline states -->
        <c:StateView
            Grid.Row="1"
            State="{Binding State}"
            Title="{Binding StateTitle}"
            Message="{Binding StateMessage}"
            Glyph="{x:Static fonts:FontAwesomeGlyphs.User}"
            GlyphFontFamily="FontAwesomeSolid"
            RetryCommand="{Binding RefreshCommand}">

            <!-- Scrollable content (profile body) -->
            <ScrollView>
                <VerticalStackLayout
                    Padding="{StaticResource LayoutPadding}"
                    Spacing="{StaticResource SpaceLg}">

                    <!-- Identity row: WhatsApp badge + Edit on Pickup Pal link -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                        <c:Badge
                            Text="Linked via WhatsApp"
                            Glyph="{x:Static fonts:FontAwesomeGlyphs.WhatsApp}"
                            Variant="Success" />

                        <Button
                            Grid.Column="1"
                            Text="Edit on Pickup Pal &#xf35d;"
                            Command="{Binding EditOnPickupPalCommand}"
                            Style="{StaticResource LinkButton}"
                            FontFamily="FontAwesomeSolid"
                            SemanticProperties.Description="Edit on Pickup Pal, opens external link" />
                    </Grid>

                    <!-- Career stats section header -->
                    <c:SectionHeader
                        Text="Career stats"
                        ActionText=""
                        ActionCommand="{x:Null}" />

                    <!-- StatTile grid (3 columns) -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource SpaceMd}" RowSpacing="{StaticResource SpaceMd}">
                        <c:StatTile
                            Grid.Row="0" Grid.Column="0"
                            Value="{Binding Profile.CareerStats.Matches, Source={x:Reference ProfilePageName}, StringFormat='{0}'}"
                            Label="Matches"
                            Glyph="{x:Static fonts:FontAwesomeGlyphs.Calendar}"
                            BindingContext="{Binding}" />

                        <c:StatTile
                            Grid.Row="0" Grid.Column="1"
                            Value="{Binding Profile.CareerStats.Goals, Source={x:Reference ProfilePageName}, StringFormat='{0}'}"
                            Label="Goals"
                            Glyph="{x:Static fonts:FontAwesomeGlyphs.Futbol}"
                            BindingContext="{Binding}" />

                        <c:StatTile
                            Grid.Row="0" Grid.Column="2"
                            Value="{Binding Profile.CareerStats.Assists, Source={x:Reference ProfilePageName}, StringFormat='{0}'}"
                            Label="Assists"
                            Glyph="{x:Static fonts:FontAwesomeGlyphs.Star}"
                            BindingContext="{Binding}" />

                        <c:StatTile
                            Grid.Row="1" Grid.Column="0"
                            Value="{Binding Profile.CareerStats.AverageRating, Source={x:Reference ProfilePageName}, StringFormat='{0:F1}'}"
                            Label="Avg rating"
                            Glyph="{x:Static fonts:FontAwesomeGlyphs.Star}"
                            BindingContext="{Binding}" />

                        <c:StatTile
                            Grid.Row="1" Grid.Column="1"
                            Value="{Binding Profile.CareerStats.MvpAwards, Source={x:Reference ProfilePageName}, StringFormat='{0}'}"
                            Label="MVP"
                            Glyph="{x:Static fonts:FontAwesomeGlyphs.Trophy}"
                            BindingContext="{Binding}" />

                        <c:StatTile
                            Grid.Row="1" Grid.Column="2"
                            Value="{Binding Profile.CareerStats.Likes, Source={x:Reference ProfilePageName}, StringFormat='{0}'}"
                            Label="Likes"
                            Glyph="{x:Static fonts:FontAwesomeGlyphs.Heart}"
                            BindingContext="{Binding}" />
                    </Grid>

                    <!-- Recent form card -->
                    <c:BrandCard>
                        <VerticalStackLayout Spacing="{StaticResource SpaceSm}">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    Text="Recent form"
                                    Style="{StaticResource TextBodyStrong}"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    Text="last 5"
                                    Style="{StaticResource TextCaption}"
                                    Opacity="0.65"
                                    VerticalOptions="Center" />
                            </Grid>

                            <!-- Result badges (W/D/L) -->
                            <FlexLayout
                                Direction="Row"
                                Wrap="NoWrap"
                                JustifyContent="Start"
                                AlignItems="Center">

                                <!-- Dynamically bind recent form results -->
                                <CollectionView ItemsSource="{Binding Profile.RecentForm, Source={x:Reference ProfilePageName}}">
                                    <CollectionView.ItemsLayout>
                                        <LinearItemsLayout
                                            Orientation="Horizontal"
                                            ItemSpacing="{StaticResource SpaceXs}" />
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="profiles:MatchResult">
                                            <c:Badge
                                                Text="{Binding ., Converter={StaticResource MatchResultConverter}}"
                                                Variant="{Binding ., Converter={StaticResource MatchResultVariantConverter}}"
                                                SemanticProperties.Description="{Binding ., Converter={StaticResource MatchResultDescriptionConverter}}" />
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </FlexLayout>
                        </VerticalStackLayout>
                    </c:BrandCard>

                    <!-- Pending confirmation note (muted, with clock glyph) -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceXs}" IsVisible="{Binding PendingNote, Source={x:Reference ProfilePageName}, Converter={StaticResource InvertedBool}, ConverterParameter=String.IsNullOrEmpty}">
                        <Label
                            Grid.Column="0"
                            Text="{x:Static fonts:FontAwesomeGlyphs.Clock}"
                            FontFamily="FontAwesomeSolid"
                            Style="{StaticResource TextCaption}"
                            Opacity="0.65"
                            VerticalOptions="Start" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding PendingNote, Source={x:Reference ProfilePageName}}"
                            Style="{StaticResource TextCaption}"
                            Opacity="0.65" />
                    </Grid>

                    <!-- View season leaderboard button -->
                    <Button
                        Text="View season leaderboard"
                        Command="{Binding OpenLeaderboardCommand}"
                        Style="{StaticResource GhostButton}" />
                </VerticalStackLayout>
            </ScrollView>
        </c:StateView>
    </Grid>
</ContentPage>
