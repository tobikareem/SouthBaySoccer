<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SouthBaySoccer.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:SouthBaySoccer.Pages"
    Shell.FlyoutBehavior="Disabled"
    Title="SouthBaySoccer">

    <!--
        Authenticated shell: a bottom TabBar matching the mobile wireframe.
        Sessions is declared first, so it is the initial route after sign-in (//sessions).
        Legacy sample pages (MainPage, DesignSystemPage, ProjectListPage, ManageMetaPage) are no
        longer on the authenticated startup path; their detail routes remain registered in
        MauiProgram for incremental migration.
    -->
    <TabBar>
        <ShellContent
            Title="Sessions"
            Icon="{StaticResource IconSessions}"
            ContentTemplate="{DataTemplate pages:SessionsHomePage}"
            Route="sessions" />

        <ShellContent
            Title="Stats"
            Icon="{StaticResource IconStats}"
            ContentTemplate="{DataTemplate pages:StatsPage}"
            Route="stats" />

        <ShellContent
            Title="Profile"
            Icon="{StaticResource IconProfile}"
            ContentTemplate="{DataTemplate pages:ProfilePage}"
            Route="profile" />
    </TabBar>

</Shell>
