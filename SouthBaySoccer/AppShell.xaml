<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SouthBaySoccer.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:SouthBaySoccer.Pages"
    Shell.FlyoutBehavior="Disabled"
    Title="N9ja Bay">

    <!--
        Authenticated shell: a bottom TabBar matching the mobile wireframe.
        Sessions is declared first, so it is the initial route after sign-in (//sessions).
        Shell renders each native tab with a platform-standard target of at least 44 dip.
        Legacy sample pages are not on the authenticated startup path.
    -->
    <TabBar x:Name="AuthenticatedTabBar">
        <ShellContent
            x:Name="SessionsTab"
            Title="Sessions"
            Icon="{StaticResource IconSessions}"
            ContentTemplate="{DataTemplate pages:SessionsHomePage}"
            Route="sessions"
            AutomationId="SessionsTab"
            SemanticProperties.Description="Sessions tab" />

        <ShellContent
            x:Name="GameDayTab"
            Title="Game Day"
            Icon="{StaticResource IconGameDay}"
            ContentTemplate="{DataTemplate pages:GameDayPage}"
            Route="gameday"
            AutomationId="GameDayTab"
            SemanticProperties.Description="Game Day tab" />

        <ShellContent
            x:Name="StatsTab"
            Title="Stats"
            Icon="{StaticResource IconStats}"
            ContentTemplate="{DataTemplate pages:StatsPage}"
            Route="stats"
            AutomationId="StatsTab"
            SemanticProperties.Description="Stats tab" />

        <ShellContent
            x:Name="PlayersTab"
            Title="Players"
            Icon="{StaticResource IconPlayers}"
            ContentTemplate="{DataTemplate pages:PlayersPage}"
            Route="players"
            AutomationId="PlayersTab"
            SemanticProperties.Description="Players tab" />
        <ShellContent
            x:Name="ProfileTab"
            Title="Profile"
            Icon="{StaticResource IconProfile}"
            ContentTemplate="{DataTemplate pages:ProfilePage}"
            Route="profile"
            AutomationId="ProfileTab"
            SemanticProperties.Description="Profile tab" />
    </TabBar>

</Shell>
