  <!-- Every XAML file in the app, mirrored wholesale so StaticResourceKeyTests can prove each
       {StaticResource} reference resolves. A hand-maintained list would silently stop covering new
       pages, which is exactly how an undefined key reached TestFlight — see
       .ai/lessons/2026-07-28-maui-staticresource-keys-crash-at-launch.md. -->
  <ItemGroup>
    <None Include="..\..\SouthBaySoccer\**\*.xaml"
          Exclude="..\..\SouthBaySoccer\bin\**\*.xaml;..\..\SouthBaySoccer\obj\**\*.xaml"
          Link="Client\XamlAll\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

